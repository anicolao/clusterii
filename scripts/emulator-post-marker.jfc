<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="Cluster bounded post-marker observation" description="Stack samples and monitor/park durations only" provider="Cluster">
  <event name="jdk.ExecutionSample"><setting name="enabled">true</setting><setting name="period">20 ms</setting></event>
  <event name="jdk.JavaMonitorEnter"><setting name="enabled">true</setting><setting name="threshold">10 ms</setting><setting name="stackTrace">true</setting></event>
  <event name="jdk.ThreadPark"><setting name="enabled">true</setting><setting name="threshold">10 ms</setting><setting name="stackTrace">true</setting></event>
</configuration>
