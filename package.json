{
  "name": "clusterii",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p functions/tsconfig.json",
    "test": "bun test tests/unit.test.ts tests/campaign.test.ts tests/travel.test.ts tests/fleet-contacts.test.ts tests/conversations.test.ts tests/briefing.test.ts tests/trades.test.ts",
    "test:browser": "playwright test",
    "emulators": "bun run --cwd functions build && firebase emulators:start --project demo-clusterii",
    "format": "biome check --write shared functions/src src/lib",
    "lint": "biome check shared functions/src src/lib && prettier --check \"src/**/*.svelte\" \"src/**/*.css\"",
    "test:service": "bun test tests/service.test.ts",
    "format:ui": "prettier --write \"src/**/*.svelte\" \"src/**/*.css\"",
    "test:stories": "node scripts/run-stories.mjs verify",
    "test:stories:generate": "node scripts/run-stories.mjs generate",
    "test:story-policy": "node --test scripts/check-story-policy.test.mjs scripts/check-catalogue-loader.test.mjs scripts/check-admission-clock.test.mjs scripts/check-credit-clock.test.mjs scripts/check-construction-clock.test.mjs && node scripts/check-story-policy.mjs",
    "test:stories:promote": "node scripts/promote-story-baselines.mjs",
    "test:story-tools": "bun test tests/story-tools.test.ts",
    "test:browser-storage": "bun test tests/recovery-store.test.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@fontsource/cormorant-garamond": "5.2.11",
    "@threlte/core": "8.6.1",
    "@threlte/extras": "9.22.2",
    "firebase": "12.16.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.3",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/bun": "1.3.10",
    "@types/node": "26.1.1",
    "@types/three": "0.183.1",
    "firebase-tools": "15.25.0",
    "material-components-web": "10.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "sharp": "0.34.5",
    "svelte": "5.56.5",
    "svelte-check": "4.7.2",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=22"
  }
}
