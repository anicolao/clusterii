TRONG",{"class":"svelte-y7bjmo"},"122"]]," ",["P",{"class":"svelte-y7bjmo"},"Balance after ",["STRONG",{"class":"svelte-y7bjmo"},"—"]]]," ",["P",{"class":"constraint svelte-y7bjmo"},"More credits are needed. Wait for production or choose another development."]," "," ",["DIV",{"class":"actions svelte-y7bjmo"},["BUTTON",{"type":"button","class":"secondary"},"Back to galaxy"],["BUTTON",{"type":"submit","disabled":""},"Build market"]]]]]]," ",["H2",{"class":"svelte-16h6p05"},"Research · shared selection and acknowledgement"]," ",["DIV",{"role":"region","aria-label":"Research specimen ready","style":"max-width:620px;margin-bottom:32px"},["SECTION",{"class":"research-instrument","aria-label":"Research selection"},["H3",{"class":"svelte-kkzxop"},"Direct your science"]," ",["P",{"class":"svelte-kkzxop"},"Orders apply at their scheduled tick. Switching preserves unfinished\n    progress; switching from a capped track moves its banked science to the new\n    target."]," ",["FORM",{"class":"svelte-kkzxop"},["FIELDSET",{"class":"svelte-kkzxop"},["LEGEND",{"class":"svelte-kkzxop"},"Research target"]," ",["DIV",{"class":"research-tracks svelte-kkzxop","role":"region","aria-label":"Research tracks","tabindex":"0"},["LABEL",{"class":"svelte-kkzxop"},["INPUT",{"__playwright_value_":"scanning","__playwright_checked_":"false","type":"radio","name":"research-target","value":"scanning","class":"svelte-kkzxop"}]," ",["SPAN",{"class":"svelte-kkzxop"},["STRONG",{"class":"svelte-kkzxop"},"scanning"],["SMALL",{"class":"svelte-kkzxop"},"Level 1 · 0 science retained"]]],["LABEL",{"class":"svelte-kkzxop"},["INPUT",{"__playwright_value_":"navigation","__playwright_checked_":"false","type":"radio","name":"research-target","value":"navigation","class":"svelte-kkzxop"}]," ",["SPAN",{"class":"svelte-kkzxop"},["STRONG",{"class":"svelte-kkzxop"},"navigation"],["SMALL",{"class":"svelte-kkzxop"},"Level 1 · 0 science retained"]]],["LABEL",{"class":"svelte-kkzxop"},["INPUT",{"__playwright_value_":"terrafo