{"type":"before","callId":"call@350","startTime":22681.101,"class":"Frame","method":"evaluateExpression","params":{"expression":"function textLayout() {\n  const texts = [];\n  // This telemetry diagnoses the inherited identity-paragraph raster failure.\n  // Galaxy text/labels do not belong to that investigation. All-screen geometry,\n  // readiness and exact pixels remain independently enforced by the story helper.\n  const root = document.querySelector('section[aria-label=\"Your identity\"]');\n  const limits = {\n    visited: 512,\n    texts: 128,\n    ancestors: 32\n  };\n  let visited = 0,\n    truncated = false;\n  const styles = new Map();\n  const styleFor = element => {\n    let style = styles.get(element);\n    if (!style) {\n      style = getComputedStyle(element);\n      styles.set(element, style);\n    }\n    return style;\n  };\n  const boxes = new Map();\n  const walker = root ? document.createTreeWalker(root, NodeFilter.SHOW_TEXT) : null;\n  for (let node = walker === null || walker === void 0 ? void 0 : walker.nextNode(); node; node = walker === null || walker === void 0 ? void 0 : walker.nextNode()) {\n    var _node$textContent;\n    if (++visited > limits.visited || texts.length >= limits.texts) {\n      truncated = true;\n      break;\n    }\n    const element = node.parentElement;\n    if (!element || !((_node$textContent = node.textContent) !== null && _node$textContent !== void 0 && _node$textContent.trim()) || !element.checkVisibility()) continue;\n    const range = document.createRange();\n    range.selectNodeContents(node);\n    const rects = [...range.getClientRects()];\n    if (!rects.some(r => r.bottom > 0 && r.right > 0 && r.top < innerHeight && r.left < innerWidth)) continue;\n    const style = styleFor(element);\n    const ancestors = [];\n    for (let ancestor = element; ancestor; ancestor = ancestor.parentElement) {\n      if (ancestors.length >= limits.ancestors) {\n        truncated = true;\n        break;\n      }\n      let evidence = boxes.get(ancestor);\n      if (!evidence) {\n        const computed = styleFor(ancestor);\n        evidence = {\n          tag: ancestor.tagName,\n          id: ancestor.id,\n          class: ancestor.getAttribute(\"class\"),\n          box: ancestor.getBoundingClientRect().toJSON(),\n          scroll: [ancestor.scrollLeft, ancestor.scrollTop],\n          transform: computed.transform,\n          zoom: computed.zoom,\n          filter: computed.filter,\n          backdropFilter: computed.backdropFilter,\n          contain: computed.contain\n        };\n        boxes.set(ancestor, evidence);\n      }\n      ancestors.push(evidence);\n    }\n    texts.push({\n      text: node.textContent,\n      rects: rects.map(r => r.toJSON()),\n      font: style.font,\n      lineHeight: style.lineHeight,\n      letterSpacing: style.letterSpacing,\n      fontKerning: style.fontKerning,\n      fontFeatureSettings: style.fontFeatureSettings,\n      fontVariationSettings: style.fontVariationSettings,\n      textRendering: style.textRendering,\n      ancestors\n    });\n  }\n  return {\n    scope: \"identity-raster\",\n    applicable: root !== null,\n    limits,\n    visited: Math.min(visited, limits.visited),\n    truncated,\n    viewport: {\n      width: innerWidth,\n      height: innerHeight,\n      dpr: devicePixelRatio\n    },\n    fontStatus: document.fonts.status,\n    fonts: [...document.fonts].map(font => ({\n      family: font.family,\n      style: font.style,\n      weight: font.weight,\n      status: font.status\n    })),\n    texts\n  };\n}","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@243","pageId":"page@42d03f746bfd7c92de00557ad985a976","beforeSnapshot":"before@call@350"}
