{
  "rules": {
    ".read": false,
    ".write": false,
    "profileCommands": {
      "$uid": {
        "$commandId": {
          ".write": "auth != null && auth.uid === $uid && (!root.child('sessionFences').child($uid).exists() || (root.child('sessionFences').child($uid).child('status').val() === 'complete' && auth.token.auth_time > root.child('sessionFences').child($uid).child('cutoff').val())) && !data.exists() && newData.exists() && $commandId.matches(/^[a-f0-9-]{36}$/)",
          ".validate": "newData.hasChildren(['format','mode','algorithm','gameId','objectId','revision','epoch','keyVersion','nonce','ciphertext','tag'])",
          "format": {
            ".validate": "newData.val() === 1"
          },
          "mode": {
            ".validate": "newData.val() === 'mock'"
          },
          "algorithm": {
            ".validate": "newData.val() === 'MOCK-PREFIX-SHA256'"
          },
          "gameId": {
            ".validate": "newData.val() === 'profile:' + $uid"
          },
          "objectId": {
            ".validate": "newData.val() === 'command:' + $commandId"
          },
          "revision": {
            ".validate": "newData.val() === 0"
          },
          "epoch": {
            ".validate": "newData.val() === 1"
          },
          "keyVersion": {
            ".validate": "newData.val() === 1"
          },
          "nonce": {
            ".validate": "newData.isString() && newData.val().length === 64"
          },
          "ciphertext": {
            ".validate": "newData.isString() && newData.val().length < 4096"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().length === 64"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "commands": {
      "$gameId": {
        "$uid": {
          "$commandId": {
            ".write": "auth != null && auth.uid === $uid && (!root.child('sessionFences').child($uid).exists() || (root.child('sessionFences').child($uid).child('status').val() === 'complete' && auth.token.auth_time > root.child('sessionFences').child($uid).child('cutoff').val())) && auth.token.developer === true && !data.exists() && newData.exists() && $gameId.matches(/^[a-f0-9-]{36}$/) && $commandId.matches(/^[a-f0-9-]{36}$/)",
            ".validate": "newData.hasChildren(['kind', 'envelope'])",
            "kind": {
              ".validate": "newData.val() === 'campaign.create' || newData.val() === 'campaign.join' || newData.val() === 'campaign.leave' || newData.val() === 'fleet.form' || newData.val() === 'fleet.disband' || newData.val() === 'fleet.load' || newData.val() === 'fleet.unload' || newData.val() === 'fleet.split' || newData.val() === 'fleet.merge' || newData.val() === 'fleet.cancel' || newData.val() === 'fleet.route' || newData.val() === 'market.focus' || newData.val() === 'research.select' || newData.val() === 'construction.build' || newData.val() === 'construction.cancel'"
            },
            "envelope": {
              ".validate": "newData.hasChildren(['format','mode','algorithm','gameId','objectId','revision','epoch','keyVersion','nonce','ciphertext','tag'])",
              "format": {
                ".validate": "newData.val() === 1"
              },
              "mode": {
                ".validate": "newData.val() === 'mock' || newData.val() === 'real'"
              },
              "algorithm": {
                ".validate": "newData.val() === (newData.parent().child('mode').val() === 'real' ? 'AES-256-GCM' : 'MOCK-PREFIX-SHA256')"
              },
              "gameId": {
                ".validate": "newData.val() === $gameId"
              },
              "objectId": {
                ".validate": "newData.val() === 'command:' + $commandId"
              },
              "revision": {
                ".validate": "newData.val() === 0"
              },
              "epoch": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
              },
              "keyVersion": {
                ".validate": "newData.val() === 1"
              },
              "nonce": {
                ".validate": "newData.isString() && newData.val().length === (newData.parent().child('mode').val() === 'real' ? 24 : 64)"
              },
              "ciphertext": {
                ".validate": "newData.isString() && newData.val().length < 4096"
              },
              "tag": {
                ".validate": "newData.isString() && newData.val().length === (newData.parent().child('mode').val() === 'real' ? 32 : 64)"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "maintenanceCommands": {
      "$gameId": {
        "$uid": {
          "$commandId": {
            ".write": "auth != null && auth.uid === $uid && (!root.child('sessionFences').child($uid).exists() || (root.child('sessionFences').child($uid).child('status').val() === 'complete' && auth.token.auth_time > root.child('sessionFences').child($uid).child('cutoff').val())) && auth.token.developer === true && !data.exists() && newData.exists() && $gameId.matches(/^[a-f0-9-]{36}$/) && $commandId.matches(/^[a-f0-9-]{36}$/)",
            ".validate": "newData.hasChildren(['kind', 'envelope'])",
            "kind": {
              ".validate": "newData.val() === 'campaign.pause' || newData.val() === 'campaign.resume'"
            },
            "envelope": {
              ".validate": "newData.hasChildren(['format','mode','algorithm','gameId','objectId','revision','epoch','keyVersion','nonce','ciphertext','tag'])",
              "format": {
                ".validate": "newData.val() === 1"
              },
              "mode": {
                ".validate": "newData.val() === 'mock' || newData.val() === 'real'"
              },
              "algorithm": {
                ".validate": "newData.val() === (newData.parent().child('mode').val() === 'real' ? 'AES-256-GCM' : 'MOCK-PREFIX-SHA256')"
              },
              "gameId": {
                ".validate": "newData.val() === $gameId"
              },
              "objectId": {
                ".validate": "newData.val() === 'command:' + $commandId"
              },
              "revision": {
                ".validate": "newData.val() === 0"
              },
              "epoch": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
              },
              "keyVersion": {
                ".validate": "newData.val() === 1"
              },
              "nonce": {
                ".validate": "newData.isString() && newData.val().length === (newData.parent().child('mode').val() === 'real' ? 24 : 64)"
              },
              "ciphertext": {
                ".validate": "newData.isString() && newData.val().length < 4096"
              },
              "tag": {
                ".validate": "newData.isString() && newData.val().length === (newData.parent().child('mode').val() === 'real' ? 32 : 64)"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "migrationCommands": {
      "$gameId": {
        "$uid": {
          "$commandId": {
            ".write": "auth != null && auth.uid === $uid && (!root.child('sessionFences').child($uid).exists() || (root.child('sessionFences').child($uid).child('status').val() === 'complete' && auth.token.auth_time > root.child('sessionFences').child($uid).child('cutoff').val())) && auth.token.developer === true && !data.exists() && newData.exists() && $gameId.matches(/^[a-f0-9-]{36}$/) && $commandId.matches(/^[a-f0-9-]{36}$/)",
            ".validate": "newData.hasChildren(['kind', 'envelope'])",
            "kind": {
              ".validate": "newData.val() === 'campaign.migrate'"
            },
            "envelope": {
              ".validate": "newData.hasChildren(['format','mode','algorithm','gameId','objectId','revision','epoch','keyVersion','nonce','ciphertext','tag'])",
              "format": {
                ".validate": "newData.val() === 1"
              },
              "mode": {
                ".validate": "newData.val() === 'mock' || newData.val() === 'real'"
              },
              "algorithm": {
                ".validate": "newData.val() === (newData.parent().child('mode').val() === 'real' ? 'AES-256-GCM' : 'MOCK-PREFIX-SHA256')"
              },
              "gameId": {
                ".validate": "newData.val() === $gameId"
              },
              "objectId": {
                ".validate": "newData.val() === 'command:' + $commandId"
              },
              "revision": {
                ".validate": "newData.val() === 0"
              },
              "epoch": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
              },
              "keyVersion": {
                ".validate": "newData.val() === 1"
              },
              "nonce": {
                ".validate": "newData.isString() && newData.val().length === (newData.parent().child('mode').val() === 'real' ? 24 : 64)"
              },
              "ciphertext": {
                ".validate": "newData.isString() && newData.val().length < 4096"
              },
              "tag": {
                ".validate": "newData.isString() && newData.val().length === (newData.parent().child('mode').val() === 'real' ? 32 : 64)"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
