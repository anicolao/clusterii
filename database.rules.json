{
  "rules": {
    ".read": false,
    ".write": false,
    "profileCommands": {
      "$uid": {
        "$commandId": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && $commandId.matches(/^[a-f0-9-]{36}$/)",
          ".validate": "newData.hasChildren(['format','mode','algorithm','gameId','objectId','revision','epoch','keyVersion','nonce','ciphertext','tag'])",
          "format": {
            ".validate": "newData.val() === 1"
          },
          "mode": {
            ".validate": "newData.val() === 'mock'"
          },
          "algorithm": {
            ".validate": "newData.val() === 'MOCK-PREFIX-SHA256'"
          },
          "gameId": {
            ".validate": "newData.val() === 'profile:' + $uid"
          },
          "objectId": {
            ".validate": "newData.val() === 'command:' + $commandId"
          },
          "revision": {
            ".validate": "newData.val() === 0"
          },
          "epoch": {
            ".validate": "newData.val() === 1"
          },
          "keyVersion": {
            ".validate": "newData.val() === 1"
          },
          "nonce": {
            ".validate": "newData.isString() && newData.val().length === 64"
          },
          "ciphertext": {
            ".validate": "newData.isString() && newData.val().length < 4096"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().length === 64"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "commands": {
      "$gameId": {
        "$uid": {
          "$commandId": {
            ".write": "auth != null && auth.uid === $uid && auth.token.developer === true && !data.exists() && newData.exists() && $gameId.matches(/^[a-f0-9-]{36}$/) && $commandId.matches(/^[a-f0-9-]{36}$/)",
            ".validate": "newData.hasChildren(['kind', 'envelope'])",
            "kind": {
              ".validate": "newData.val() === 'campaign.create' || newData.val() === 'campaign.join' || newData.val() === 'campaign.leave'"
            },
            "envelope": {
              ".validate": "newData.hasChildren(['format','mode','algorithm','gameId','objectId','revision','epoch','keyVersion','nonce','ciphertext','tag'])",
              "format": {
                ".validate": "newData.val() === 1"
              },
              "mode": {
                ".validate": "newData.val() === 'mock'"
              },
              "algorithm": {
                ".validate": "newData.val() === 'MOCK-PREFIX-SHA256'"
              },
              "gameId": {
                ".validate": "newData.val() === $gameId"
              },
              "objectId": {
                ".validate": "newData.val() === 'command:' + $commandId"
              },
              "revision": {
                ".validate": "newData.val() === 0"
              },
              "epoch": {
                ".validate": "newData.val() === 1"
              },
              "keyVersion": {
                ".validate": "newData.val() === 1"
              },
              "nonce": {
                ".validate": "newData.isString() && newData.val().length === 64"
              },
              "ciphertext": {
                ".validate": "newData.isString() && newData.val().length < 4096"
              },
              "tag": {
                ".validate": "newData.isString() && newData.val().length === 64"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
